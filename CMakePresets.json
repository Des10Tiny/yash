{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/${presetName}"
    },

    {
      "name": "Debug-Tests-Sanitizers",
      "displayName": "Debug | Tests | Sanitizers",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "ON",
        "BUILD_TESTS_SANITIZED": "ON"
      }
    },

    {
      "name": "Debug-Tests",
      "displayName": "Debug | Tests",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "ON",
        "BUILD_TESTS_SANITIZED": "OFF"
      }
    },
    {
      "name": "Release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTS": "OFF",
        "BUILD_TESTS_SANITIZED": "OFF"
      }
    },
    {
      "name": "Release-Tests",
      "displayName": "Release | Tests",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTS": "ON",
        "BUILD_TESTS_SANITIZED": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "base-build",
      "hidden": true,
      "jobs": 0
    },
    {
      "name": "Debug-Tests-Sanitizers",
      "configurePreset": "Debug-Tests-Sanitizers",
      "inherits": "base-build"
    },
    {
      "name": "Debug-Tests",
      "configurePreset": "Debug-Tests",
      "inherits": "base-build"
    },
    {
      "name": "Release",
      "configurePreset": "Release",
      "inherits": "base-build"
    },
    {
      "name": "Release-Tests",
      "configurePreset": "Release-Tests",
      "inherits": "base-build"
    }
  ]
}
